# RackWire discovery — environment template.
#
# Copy to /etc/rackwire/discovery.env (chmod 600, owned by root:rackwire) and
# fill in real values. This file is a TEMPLATE with NO real secrets — never
# commit the filled-in copy. Systemd loads it via EnvironmentFile.

# --- Storage -------------------------------------------------------------
RACKWIRE_DB_PATH=/var/lib/rackwire/discovery.db

# --- Scan authorization --------------------------------------------------
# Comma-separated CIDRs discovery is permitted to scan. REQUIRED — an empty
# list denies every explicit target. The homelab management range:
RACKWIRE_ALLOWED_SUBNETS=10.0.0.0/24

# --- SNMP read credentials ----------------------------------------------
# v2c community (read-only) or configure v3 below. Keep this file 600.
RACKWIRE_SNMP_VERSION=2c
RACKWIRE_SNMP_COMMUNITY=public
# RACKWIRE_SNMP_V3_USER=
# RACKWIRE_SNMP_V3_AUTHPROTO=SHA
# RACKWIRE_SNMP_V3_AUTHKEY=
# RACKWIRE_SNMP_V3_PRIVPROTO=AES
# RACKWIRE_SNMP_V3_PRIVKEY=

# --- Claude inference (optional) ----------------------------------------
# Leave the key empty to run deterministic-only. When set AND enabled, unknown/
# low-confidence devices are classified by the Anthropic API. Reference only —
# never echo this value into a log.
ANTHROPIC_API_KEY=
RACKWIRE_CLAUDE_ENABLED=false
RACKWIRE_CLAUDE_MODEL=claude-sonnet-5

# --- Session / CSRF ------------------------------------------------------
# REQUIRED for multi-worker gunicorn so every worker validates the same CSRF
# tokens. Generate with: openssl rand -hex 32
RACKWIRE_SESSION_SECRET=

# --- Bind (behind the Apache reverse proxy) ------------------------------
RACKWIRE_BIND_HOST=127.0.0.1
RACKWIRE_BIND_PORT=8785
RACKWIRE_HOST_CONCURRENCY=32
